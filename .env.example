# ============================================================
# SatQuery AI — Environment Variables Example
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# === Application ===
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SatQuery AI

# === File Storage ===
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=500

# === Model Paths ===
# Leave blank if not yet trained (Stage 1)
VLM_ADAPTER_PATH=
GROUNDING_DINO_PATH=models/grounding/
SAM2_CHECKPOINT_PATH=models/segmentation/

# === Model Device ===
# Options: cpu | cuda | mps
MODEL_DEVICE=cpu

# === Model Quantization ===
# Options: none | 4bit | 8bit
MODEL_QUANTIZATION=none

# === Remote Sensing Thresholds ===
NDVI_VEGETATION_THRESHOLD=0.3
NDWI_WATER_THRESHOLD=0.0
CHANGE_THRESHOLD_PERCENTILE=95

# === STAC (optional) ===
STAC_API_URL=
STAC_COLLECTION=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
